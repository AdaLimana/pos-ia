{
  "name": "jupyter",
  "image": "jupyter/scipy-notebook",
  "runArgs": [
    "--name", "pos_ia_lab",
    // "-v", ".:/home/jovyan/work/",
    "-p", "8888:8888",
    "--network", "host"
  ],
  "mounts": [
    "source=${localWorkspaceFolder},target=/home/jovyan/work,type=bind"
  ],
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-toolsai.jupyter",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-slideshow",
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.vscode-python-envs",
        "ms-toolsai.jupyter-keymap"
      ]
    }
  },
  "postCreateCommand": "pip install requests feature_engine \"pandas<3.0\" \"numba>=0.59\" \"numpy==1.26.4\""
}